      "__type": "dir",
      "__required": true,
      "__private": false
    },
    {
      "name": "inputCSV",
      "type": "string",
      "doc": "Path direct to input CSV file wich has format SampleID,READ1,READ2,Longread",
      "default": "env://amr/data/",
      "__type": "path",
      "__required": true,
      "__private": false
    },
    {
      "name": "doradoModelPath",
      "type": "string",
      "doc": "Path of dorado model",
      "default": "env://dorado/dorado_model/",
      "__type": "dir",
      "__required": true,
      "__private": false
    },
    {
      "name": "pod5folderlist",
      "type": ["null", "string"],
      "doc": "pod5 folder list file (txt format one folder per sample)",
      "default": null,
      "__type": "path",
      "__required": false,
      "__private": false
    },
    {
      "name": "model",
      "type": "string",
      "doc": "specify path of model or automatic model selection |hac|sup",
      "default": "sup",
      "__type": "path",
      "__required": true,
      "__private": false
    },
    {
      "name": "nextstrain_method",
      "type": "string",
      "doc": "Nextstrain tree builder to use [fasttree,raxml,iqtree]",
      "default": "iqtree",
      "__required": false,
      "__private": true
    },
    {
      "name": "nextstrain_metadata",
      "type": "string",
      "doc": "sequence metadata, as CSV or TSV for nextstrain (Must contain strain,country,location,Lineage and date eg. strain|location|date|Lineage|DST)",
      "default": "env://tb/db/meta.csv",
      "__required": true,
      "__private": true
    },
    {
      "name": "nextstrain_root",
      "type": "string",
      "doc": "rooting mechanism ('best', least-squares', 'min_dev','oldest') OR node to root by OR two nodes indicating amonophyletic group to root by. Check augar refine --help for more info",
      "default": "best",
      "__required": true,
      "__private": true
    },
    {
      "name": "nextstrain_coalescent",
      "type": "string",
      "doc": "coalescent time scale in units of inverse clock rate (float), optimize as scalar ('opt'), or skyline ('skyline')",
      "default": "opt",
      "__required": true,
      "__private": true
    },
    {
      "name": "nextstrain_inference",
      "type": "string",
      "doc": "calculate joint or marginal maximum likelihood ancestral sequence states",
      "default": "joint",
      "__required": true,
      "__private": true
    },
    {
      "name": "nextstrain_columns",
      "type": "string",
      "doc": "metadata fields to perform discrete reconstruction on. Must be relate with column in meta data.",
      "default": "location",
      "__required": true,
      "__private": true
    },
    {
      "name": "auspice_config",
      "type": "string",
      "doc": "Auspice configuration file.",
      "default": "env://amr/nextstrain/auspice.json",
      "__type": "path",
      "__required": true,
      "__private": true
    },
    {
      "name": "geo_info",
      "type": "string",
      "doc": "Latitudes and longitudes for geography traits in TSV file format. [location|location_name|lat|long]",
      "default": "env://tb/nextstrain/lat_long.tsv",
      "__type": "path",
      "__required": true,
      "__private": true
    },
    {
      "name" : "method",
      "type" : "string",
      "symbols": ["nano16SJunya", "null"],
      "default" : "null",
      "__required": true,
      "__private": false
    },
    {
      "name": "indexnanofile",
      "type": ["null", "string"],
      "doc": "Path to metadata folder which contain text file",
      "default": "string",
      "__required": true,
      "__private": true
    },
    {
      "name": "qscore",
      "type": "int",
      "doc": "Phred assigns a Q score",
      "default": 15,
      "__required": true,
      "__private": false
    },
    {
      "name": "dbtaxonomy",
      "doc": "Path to database for taxonomy classification based on kraken2",
      "type": {
        "name": "referenceEnumType",
        "type": "enum",
        "symbols": [
          "k2_standard_16gb",
          "16S_RDP",
          "16S_SILVA138",
          "16S_Greengenes2",
          "ncbi_16S_18S"
        ],
        "default": "k2_standard_16gb"
      },
      "default": "k2_standard_16gb",
      "__type": "path",
      "__required": true,
      "__private": false,
      "__need_resolve": {
        "dbtaxonomy": "__PATH_BY_DATABASE"
      },
      "__PATH_BY_DATABASE": {
        "k2_standard_16gb": "env://kraken_db/k2_standard_16gb_20240605",
        "16S_RDP": "env://kraken_db/16S_RDP_k2db",
        "16S_SILVA138": "env://kraken_db/SILVA_138_2_k2db",
        "16S_Greengenes2": "env://kraken_db/k2__gg2-entire",
        "ncbi_16S_18S": "env://kraken_db/ncbi_16s_18s_kraken2"
      }
    },
    {
