      "__required": true,
      "__private": false
    },
    {
      "name": "mode",
      "doc": "Analysis mode : shortRead|longRead|hybrid|hybrid_long|phylo|taxo|custom_phylo|custom_phyloNextstrain|pod5|pod5_assembly",
      "type": "string",
      "default": "shortRead",
      "__type": "dir",
      "__required": false
    },
    {
      "name": "taxonID",
      "doc": "Taxon ID that you want to get. Default is 1 mean root",
      "type": "string",
      "default": "1",
      "__type": "dir",
      "__required": false
    },
    {
      "name": "prokka_kingdom",
      "doc": "Annotation mode: Archaea|Bacteria|Mitochondria|Viruses",
      "type": "string",
      "default": "Bacteria",
      "__type": "dir",
      "__required": false

    },
    {
      "name": "selectedSampleIds",
      "type": ["null", "string"],
      "doc": "Specify file contain selected sample ID write in file line by line. Program will run only sample that present in this file.",
      "default": null,
      "__type": "path",
      "__required": false,
      "__private": false
    },
    {
      "name": "spatypeDB",
      "type": "string",
      "doc": "Path of spatype database",
      "default": "env://amr/db/spatype_db",
      "__type": "dir",
      "__required": true,
      "__private": false
    },
    {
      "name": "enableRoary",
      "type": "boolean",
      "doc": "Enable roary module",
      "default": false,
      "__required": true,
      "__private": true
    },
    {
      "name": "enableRAXML",
      "type": "boolean",
      "doc": "Enable RAXML module",
      "default": false,
      "__required": true,
      "__private": true
    },
    {
      "name": "sequence_fasta",
      "type": "string",
