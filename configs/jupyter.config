process {
  executor = 'local'
  //queue = 'memory'
  cache = 'lenient'

  withName: shortreadFastQC {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_env"
    module = "Miniconda3/4.9.2"
    cpus = 8
    memory = '16 GB'
    time = '1d'
  }
  withName: shortreadtrimming {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_env"
    module = "Miniconda3/4.9.2"
    cpus = 10
    memory = '16 GB'
    time = '1d'
  }
  withName: kraken2_classify {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_kraken2_env"
    module = "Miniconda3/4.9.2"
    cpus = 12
    memory = '32 GB'
    time = '1d'
  }
  withName: kraken2_classify_longread {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_kraken2_env"
    module = "Miniconda3/4.9.2"
    cpus = 12
    memory = '32 GB'
    time = '1d'
  }
  withName: run_porechop {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_env"
    //module = "Miniconda3/4.9.2"
    cpus = 8
    memory = '16 GB'
    //time = '1d'
  }
  withName: run_nanoplot {
    conda = "/nbt_main/share/pachyderm/conda_env/nanoplot_env"
    module = "Miniconda3/4.9.2"
    cpus = 2
    memory = '8 GB'
    time = '1d'
  }

  withName: Hybrid_assembly {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_unicycler_env2"
    module = "Miniconda3/4.9.2:SAMtools/1.16.1-GCC-11.3.0"
    cpus = 32
    memory = '32 GB'
    time = '1d'
  }

  withName: Shortread_assembly {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_unicycler_env2"
