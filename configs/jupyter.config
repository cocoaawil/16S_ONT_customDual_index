    conda = "/nbt_main/share/pachyderm/conda_env/amr_abricate_env"
    module = "Miniconda3/4.9.2"
    cpus = 2
    memory = '8 GB'
    time = '1d'
  }

  withName: Abricate_Summary {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_abricate_env"
    module = "Miniconda3/4.9.2"
    cpus = 2
    memory = '8 GB'
    time = '1d'
  }
  
  withName: run_roary{
    container = '/nbt_main/share/pachyderm/singularity_img/roary_latest.sif'
