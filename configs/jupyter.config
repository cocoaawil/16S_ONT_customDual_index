    memory = '16 GB'
    time = '1d'
  }

  withName: run_medaka_longfirst{
    conda = "/nbt_main/share/pachyderm/conda_env/amr_medaka_env"
    module = "Miniconda3/4.9.2:SAMtools/1.16.1-GCC-11.3.0"
    cpus = 2
    memory = '16 GB'
    time = '1d'
  }

  withName: run_quast {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_env"
    module = "Miniconda3/4.9.2"
    cpus = 8
    memory = '16 GB'
    time = '1d'
  }

  withName: run_quast_short {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_env"
    module = "Miniconda3/4.9.2"
    cpus = 8
    memory = '16 GB'
    time = '1d'
  }

  withName: run_quast_long {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_env"
    module = "Miniconda3/4.9.2"
    cpus = 8
    memory = '16 GB'
    time = '1d'
  }

  withName: run_quast_hybrid {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_env"
    module = "Miniconda3/4.9.2"
    cpus = 8
    memory = '16 GB'
    time = '1d'
  }

