    time = '1d'
  }

  withName: run_flye_ont_longfirst {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_flye_env"
    module = "Miniconda3/4.9.2"
    cpus = 12
    memory = '32 GB'
    time = '1d'
  }

  withName: run_medaka {
    conda = "/nbt_main/share/pachyderm/conda_env/amr_medaka_env"
    module = "Miniconda3/4.9.2:SAMtools/1.16.1-GCC-11.3.0"
