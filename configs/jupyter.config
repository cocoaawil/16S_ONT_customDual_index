  withName: 'qualityfilter|singlereadFastQC|run_kraken2report|run_braken' {
    //conda = "/nbt_main/share/pachyderm/conda_env/amr_kraken2_env"
    conda = "/home/jovyan/conda_env/ONT16Sanalysis"
    //module = "Miniconda3/4.9.2"
